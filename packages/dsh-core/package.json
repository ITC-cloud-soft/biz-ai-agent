    "directory": "packages/dsh-core"
  },
  "bugs": {
    "url": "https://github.com/ITC-cloud-soft/biz-ai/issues"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./tools-sdk": "./src/tools-sdk.js",
    "./runtime": "./src/runtime.js",
    "./api": "./src/api-client.js",
    "./registry": "./src/registry.js",
    "./app-switch": "./src/app-switch.js",
    "./apps": "./src/apps.js",
    "./secretary": "./src/secretary.js",
    "./persona": "./src/persona.js",
    "./ai-profile": "./src/ai-profile.js",
    "./link-guard": "./src/link-guard.js",
    "./help-tool": "./src/help-tool.js",
    "./delivery": "./src/delivery.js",
    "./outbound": "./src/outbound.js",
    "./session": "./src/session.js",
    "./manifest": "./src/manifest.js",
    "./delegation": "./src/delegation.js",
    "./plugin": "./src/plugin.js",
    "./compat/care-billing-paths": "./src/compat/care-billing-paths.js",
