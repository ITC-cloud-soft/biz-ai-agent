    "url": "git+https://github.com/ITC-cloud-soft/biz-ai.git",
    "directory": "packages/telemetry"
  },
  "bugs": {
    "url": "https://github.com/ITC-cloud-soft/biz-ai/issues"
  },
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./mask": "./src/mask.mjs",
    "./trace": "./src/trace.mjs",
